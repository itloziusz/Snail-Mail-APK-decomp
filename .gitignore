# Proprietary original inputs: never committed. See original/README.md.
/original/*
!/original/README.md

# Local working copies (extracted APK, decompiler output, Ghidra projects).
/work/

# Bulk generated exports that embed decompiled proprietary code. Regenerate
# with the scripts under tools/. Indices/manifests live elsewhere and ARE tracked.
/analysis/native/generated/
/analysis/assets/extracted/

# Build outputs
/build/
/build-*/
**/build/
**/.cxx/
**/.gradle/
*.o
*.a
*.so
*.apk
*.aab
*.keystore
*.jks
local.properties
__pycache__/
*.pyc

# AOT translation output: embeds the original binary's code semantics and data
# bytes. Regenerate locally with tools/aot/arm2c.py; never commit.
/aot/generated/

# Exact original artwork is extracted locally from the owner's asset archive.
/android/app/src/main/assets/port/menu-original.png
/android/app/src/main/assets/port/loading-original.png
